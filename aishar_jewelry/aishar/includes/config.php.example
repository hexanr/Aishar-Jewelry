// ---- إعدادات قاعدة البيانات ----
define('DB_HOST', 'localhost');
define('DB_NAME', 'your_database_name');
define('DB_USER', 'your_database_user');
define('DB_PASS', 'your_database_password');
define('DB_CHARSET', 'utf8mb4');

// ---- إعدادات الموقع ----
// غيري السطر أدناه فقط عند الرفع على السيرفر
// مثال محلي:  'http://localhost/aishar'
// مثال رفع:   'https://www.yourdomain.com'
define('SITE_ROOT',   dirname(__DIR__));
// رابط الموقع يُكتشف تلقائياً (يناسب ngrok لأن رابطه يتغير).
// عند الرفع على استضافة حقيقية ضعي رابطك الثابت هنا، مثال: 'https://www.yourdomain.com'
$FIXED_SITE_URL = '';
if ($FIXED_SITE_URL !== '') {
    define('SITE_URL', rtrim($FIXED_SITE_URL, '/'));
} else {
    $https  = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')
           || (($_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '') === 'https');
    $docRoot = str_replace('\\', '/', (string)realpath($_SERVER['DOCUMENT_ROOT'] ?? ''));
    $siteDir = str_replace('\\', '/', SITE_ROOT);
    $base    = ($docRoot !== '' && stripos($siteDir, $docRoot) === 0) ? substr($siteDir, strlen($docRoot)) : '';
    define('SITE_URL', ($https ? 'https' : 'http') . '://' . ($_SERVER['HTTP_HOST'] ?? 'localhost') . $base);
}
define('UPLOAD_PATH', SITE_ROOT . '/assets/images/uploads/');
define('UPLOAD_URL',  SITE_URL  . '/assets/images/uploads/');

// ---- الجلسة ----
ini_set('session.cookie_httponly', 1);
ini_set('session.use_strict_mode', 1);
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

// ---- قاعدة البيانات ----
function getDB(): PDO {
    static $pdo = null;
    if ($pdo === null) {
        $dsn = "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=" . DB_CHARSET;
        try {
            $pdo = new PDO($dsn, DB_USER, DB_PASS, [
                PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
                PDO::ATTR_EMULATE_PREPARES   => false,
            ]);
        } catch (PDOException $e) {
            error_log('DB connection failed: ' . $e->getMessage());
            http_response_code(500);
            die('<div style="font-family:sans-serif;padding:2rem;color:#c00">تعذر الاتصال بقاعدة البيانات. تحققي من إعدادات includes/config.php.</div>');
        }
    }
    return $pdo;
}

// ---- اللغة ----
$lang = $_SESSION['lang'] ?? $_COOKIE['lang'] ?? 'ar';
if (!in_array($lang, ['ar','en'])) $lang = 'ar';
define('LANG',   $lang);
define('IS_RTL', $lang === 'ar');
define('DIR',    IS_RTL ? 'rtl' : 'ltr');

function switchLang(string $current): string {
    return $current === 'ar' ? 'en' : 'ar';
}

// ---- الإعدادات ----
function getSetting(string $key, string $default = ''): string {
    static $settings = [];
    if (empty($settings)) {
        try {
            $rows = getDB()->query("SELECT setting_key, setting_value FROM settings")->fetchAll();
            foreach ($rows as $r) $settings[$r['setting_key']] = $r['setting_value'];
        } catch (Exception $e) { return $default; }
    }
    return $settings[$key] ?? $default;
}

// ---- روابط السوشيال ----
// القيمة في الإعدادات ممكن تكون: رابط كامل (https://...) أو اسم الحساب فقط (aisharjewelry).
// لو فاضية أو لسه القيمة القديمة 'aishar.jewelry' نستخدم حسابات آيشار الرسمية.
function socialUrl(string $platform): string {
    $official = [
        'instagram' => 'https://www.instagram.com/aisharjewelry',
        'tiktok'    => 'https://www.tiktok.com/@aisharjewelry',
        'facebook'  => 'https://www.facebook.com/share/1DAp7nBRPd/?mibextid=wwXIfr',
        'pinterest' => 'https://pin.it/3S2xQx42e',
        'snapchat'  => '',
    ];
    $bases = [
        'instagram' => 'https://www.instagram.com/',
        'tiktok'    => 'https://www.tiktok.com/@',
        'facebook'  => 'https://www.facebook.com/',
        'pinterest' => 'https://www.pinterest.com/',
        'snapchat'  => 'https://www.snapchat.com/add/',
    ];
    $v = trim(getSetting('site_' . $platform));
    if ($v === '' || $v === 'aishar.jewelry') return $official[$platform] ?? '';
    if (preg_match('~^(https?:)?//~i', $v) || stripos($v, 'www.') === 0) {
        return stripos($v, 'http') === 0 ? $v : 'https://' . ltrim($v, '/');
    }
    return ($bases[$platform] ?? '') . ltrim($v, '@/');
}

// اسم حساب إنستجرام للعرض (@aisharjewelry)
function instagramHandle(): string {
    $u = socialUrl('instagram');
    if (preg_match('~instagram\.com/([^/?#]+)~i', $u, $m)) return $m[1];
    return 'aisharjewelry';
}

// ---- ترجمة ----
function t(array $row, string $field): string {
    return $row[$field . '_' . LANG] ?? $row[$field . '_ar'] ?? '';
}

// ---- تنسيق السعر ----
function formatPrice(float $price): string {
    return number_format($price, 0) . ' ' . getSetting('currency_symbol', 'د.ع');
}

// ---- CSRF ----
function csrfToken(): string {
    if (empty($_SESSION['csrf_token'])) {
        $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
    }
    return $_SESSION['csrf_token'];
}

function verifyCsrf(): bool {
    $token = $_POST['csrf_token'] ?? $_SERVER['HTTP_X_CSRF_TOKEN'] ?? '';
    return hash_equals($_SESSION['csrf_token'] ?? '', $token);
}

function csrfField(): string {
    return '<input type="hidden" name="csrf_token" value="' . csrfToken() . '">';
}

// ---- XSS ----
function e(string $str): string {
    return htmlspecialchars($str, ENT_QUOTES, 'UTF-8');
}

// ---- Flash ----
function setFlash(string $type, string $msg): void {
    $_SESSION['flash'] = ['type' => $type, 'msg' => $msg];
}

function getFlash(): ?array {
    if (!empty($_SESSION['flash'])) {
        $f = $_SESSION['flash'];
        unset($_SESSION['flash']);
        return $f;
    }
    return null;
}

// ---- Redirect ----
function redirect(string $url): void {
    header("Location: $url");
    exit;
}

// ---- Slug ----
function makeSlug(string $text): string {
    $text = preg_replace('/[^\p{L}\p{N}\s-]/u', '', mb_strtolower($text));
    $text = preg_replace('/[\s-]+/', '-', trim($text));
    return $text ?: uniqid();
}

// ---- رقم الطلب ----
function generateOrderNumber(): string {
    return 'AIS-' . strtoupper(substr(uniqid(), -6)) . '-' . date('y');
}

// ---- الأدمن ----
function isAdminLoggedIn(): bool {
    return !empty($_SESSION['admin_id']) && !empty($_SESSION['admin_role']);
}

function requireAdmin(): void {
    if (!isAdminLoggedIn()) redirect(SITE_URL . '/admin/login.php');
}

// ---- السلة ----
function getCart(): array { return $_SESSION['cart'] ?? []; }

function getCartCount(): int {
    return array_sum(array_column(getCart(), 'qty'));
}

function getCartTotal(): float {
    $total = 0;
    foreach (getCart() as $item) $total += $item['price'] * $item['qty'];
    return $total;
}

// ---- قياسات الخواتم ----
// products.sizes = قائمة مفصولة بفواصل (مثال: 6,7,8,9). فارغة = فري سايز (بدون اختيار قياس)
function ensureSizeColumns(): void {
    if (!empty($_SESSION['_size_cols_ok'])) return;
    try {
        $db = getDB();
        if (!$db->query("SHOW COLUMNS FROM products LIKE 'sizes'")->fetch()) {
            $db->exec("ALTER TABLE products ADD COLUMN sizes VARCHAR(100) NULL DEFAULT NULL AFTER weight");
        }
        if (!$db->query("SHOW COLUMNS FROM order_items LIKE 'size'")->fetch()) {
            $db->exec("ALTER TABLE order_items ADD COLUMN size VARCHAR(20) NULL DEFAULT NULL AFTER product_sku");
        }
        $_SESSION['_size_cols_ok'] = 1;
    } catch (Throwable $e) {
        error_log('ensureSizeColumns: ' . $e->getMessage());
    }
}

function parseSizes(?string $csv): array {
    if ($csv === null || trim($csv) === '') return [];
    $out = [];
    foreach (preg_split('/[,\x{060C};\s]+/u', $csv) as $s) {
        $s = trim($s);
        if ($s !== '' && strlen($s) <= 20 && !in_array($s, $out, true)) $out[] = $s;
    }
    return $out;
}

function cartKey(int $productId, ?string $size): string {
    return $size !== null && $size !== '' ? $productId . '_' . $size : (string)$productId;
}

/**
 * يرجع: true عند النجاح، أو 'need_size' إذا المنتج له قياسات ولم يُختر قياس، أو false.
 */
function addToCart(int $productId, int $qty = 1, ?string $size = null): bool|string {
    ensureSizeColumns();
    $stmt = getDB()->prepare("SELECT id,slug,name_ar,name_en,price,images,stock,sizes FROM products WHERE id=? AND is_active=1");
    $stmt->execute([$productId]);
    $p = $stmt->fetch();
    if (!$p || $p['stock'] < 1) return false;

    $sizes = parseSizes($p['sizes'] ?? '');
    $size  = $size !== null ? trim(strip_tags($size)) : null;
    if ($sizes) {
        if ($size === null || $size === '') return 'need_size';
        if (!in_array($size, $sizes, true)) return 'need_size';
    } else {
        $size = null; // فري سايز
    }

    $imgs  = json_decode($p['images'] ?? '[]', true);
    $image = $imgs[0] ?? '';
    $key   = cartKey((int)$p['id'], $size);

    if (isset($_SESSION['cart'][$key])) {
        $_SESSION['cart'][$key]['qty'] += $qty;
    } else {
        $_SESSION['cart'][$key] = [
            'id'      => $p['id'],
            'slug'    => $p['slug'],
            'name_ar' => $p['name_ar'],
            'name_en' => $p['name_en'],
            'price'   => (float)$p['price'],
            'image'   => $image,
            'size'    => $size,
            'qty'     => $qty,
        ];
    }
    return true;
}

function removeFromCart(string $key): void { unset($_SESSION['cart'][$key]); }
function clearCart(): void { unset($_SESSION['cart']); }

// ---- تنظيف ----
function sanitize(string $val): string { return trim(strip_tags($val)); }

// ---- Pagination ----
function paginate(int $total, int $perPage, int $current): array {
    $pages = (int)ceil($total / max(1, $perPage));
    return [
        'total'   => $total,
        'pages'   => $pages,
        'current' => $current,
        'prev'    => $current > 1 ? $current - 1 : null,
        'next'    => $current < $pages ? $current + 1 : null,
        'offset'  => ($current - 1) * $perPage,
    ];
}

// ---- رفع الصور ----
function uploadImage(array $file, string $folder = 'products'): string|false {
    $allowed = ['image/jpeg','image/png','image/webp','image/gif'];
    if (!in_array($file['type'], $allowed) || $file['size'] > 5 * 1024 * 1024) return false;
    $ext  = strtolower(pathinfo($file['name'], PATHINFO_EXTENSION));
    $name = uniqid() . '_' . time() . '.' . $ext;
    $dir  = UPLOAD_PATH . $folder . '/';
    if (!is_dir($dir)) mkdir($dir, 0755, true);
    return move_uploaded_file($file['tmp_name'], $dir . $name) ? $folder . '/' . $name : false;
}

// ---- الشحن ----
function calcShipping(float $subtotal): float {
    $free = (float)getSetting('free_shipping_min', '75000');
    $cost = (float)getSetting('shipping_cost', '5000');
    return $subtotal >= $free ? 0 : $cost;
}

// ---- مزايا الطلب: تغليف مميز / توصيل مجاني / هدية (حسب قيمة الطلب بعد الخصم) ----
function orderPerks(float $net): array {
    $defs = [
        ['key'=>'packaging','min'=>(float)getSetting('premium_pack_min','30000'),'icon'=>'fa-box-open','ar'=>'تغليف مميز مجاني','en'=>'Free premium packaging'],
        ['key'=>'shipping', 'min'=>(float)getSetting('free_shipping_min','75000'),'icon'=>'fa-truck',   'ar'=>'توصيل مجاني',      'en'=>'Free delivery'],
        ['key'=>'gift',     'min'=>(float)getSetting('gift_min','125000'),         'icon'=>'fa-gift',    'ar'=>'هدية مجانية',      'en'=>'Free gift'],
    ];
    usort($defs, fn($a,$b)=>$a['min']<=>$b['min']);
    foreach ($defs as &$d) {
        $d['ok']       = $net >= $d['min'];
        $d['left']     = max(0, $d['min'] - $net);
        $d['label_ar'] = $d['ar'];
        $d['label']    = LANG==='ar' ? $d['ar'] : $d['en'];
    }
    return $defs;
}

// ---- الكوبون ----
function validateCoupon(string $code, float $subtotal): array {
    $stmt = getDB()->prepare("
        SELECT * FROM coupons
        WHERE code=? AND is_active=1
        AND (max_uses IS NULL OR used_count < max_uses)
        AND (expires_at IS NULL OR expires_at >= CURDATE())
    ");
    $stmt->execute([$code]);
    $coupon = $stmt->fetch();
    if (!$coupon) return ['valid'=>false, 'msg'=> LANG==='ar'?'كود الخصم غير صالح':'Invalid coupon'];
    if ($subtotal < $coupon['min_order']) {
        return ['valid'=>false, 'msg'=> (LANG==='ar'?'الحد الأدنى ':'Min order ') . formatPrice($coupon['min_order'])];
    }
    $discount = $coupon['discount_type']==='percentage'
        ? $subtotal * ($coupon['discount_value'] / 100)
        : $coupon['discount_value'];
    return ['valid'=>true, 'discount'=>round($discount,2), 'coupon'=>$coupon];
}
